@@ -1439,6 +1440,31 @@ void WebLocalFrameImpl::RemoveSpellingMarkersUnderWords(
   GetFrame()->RemoveSpellingMarkersUnderWords(converted_words);
 }
 
+void WebLocalFrameImpl::RecheckSpelling() {
+  SpellChecker& spell_checker = GetFrame()->GetSpellChecker();
+  spell_checker.RemoveSpellingMarkers();
+  if (!spell_checker.IsSpellCheckingEnabled())
+    return;
+
+  // The idle spell checker would check only around the selection and skip the
+  // content it has fully checked before, so check the whole editable content
+  // right away, bypassing the cached results.
+  Document& document = *GetFrame()->GetDocument();
+  document.UpdateStyleAndLayout(DocumentUpdateReason::kSpellCheck);
+  const Position focus =
+      GetFrame()->Selection().GetSelectionInDOMTree().Focus();
+  const Element* root_editable = DynamicTo<Element>(HighestEditableRoot(focus));
+  if (!root_editable && document.body() && IsEditable(*document.body()))
+    root_editable = document.body();
+  if (root_editable && root_editable->isConnected() &&
+      spell_checker.GetSpellCheckRequester().RequestCheckingFor(
+          EphemeralRange::RangeOfContents(*root_editable), /*request_num=*/0,
+          /*should_force_refresh=*/true)) {
+    return;
+  }
+  spell_checker.RespondToChangedContents();
+}
